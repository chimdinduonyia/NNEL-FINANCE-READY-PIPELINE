# Copy this file to .env and fill in your real values.
# .env is listed in .gitignore and must never be committed.

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nnel_app
DB_PASSWORD=REPLACE_WITH_YOUR_DB_PASSWORD
DB_NAME=nnel_frp

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
# Token lifetime. Examples: 8h, 1d, 7d
JWT_EXPIRES_IN=8h

# --- Server ---
PORT=3000

# --- Email (Resend) ---
# Get an API key at https://resend.com. Without a verified sending domain,
# Resend only lets you send to the email address your Resend account itself
# uses — fine for testing, verify a real domain before inviting other people.
RESEND_API_KEY=re_REPLACE_WITH_YOUR_KEY
EMAIL_FROM=NNEL Pipeline Tracker <onboarding@resend.dev>
# Used to build links in emails (e.g. the invite link). No trailing slash.
APP_BASE_URL=http://localhost:3000